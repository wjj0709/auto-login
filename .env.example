# AnyRouter 账号配置 (JSON 数组格式，需用双引号包裹并转义内部双引号)
# cookies 支持 JSON 对象或 "key1=val1; key2=val2" 字符串格式
ANYROUTER_ACCOUNTS="[{\"cookies\":{\"session\":\"你的session值\"},\"api_user\":\"你的api_user值\"}]"

# 可选：自定义 Provider 配置 (JSON 对象格式，会覆盖内置配置)
# PROVIDERS={"custom":{"domain":"https://example.com","api_user_key":"x-api-user","sign_in_path":"/api/user/sign_in"}}

# 可选：邮件通知配置
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# CUSTOM_SMTP_SERVER=
