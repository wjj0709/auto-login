# =============================================================================
# AnyRouter 自动签到工具 — 环境变量配置示例
# 使用：cp .env.example .env 后按需编辑
# 注意：JSON 值必须用双引号包裹，内部双引号用 \" 转义
# =============================================================================

# -------- 账号配置（必填）--------
# 格式：JSON 数组，每个元素一个账号
# 字段：
#   cookies      必填  JSON 对象 {"session":"xxx"} 或字符串 "session=xxx"
#   api_user     必填  new-api-user 请求头的值
#   provider     可选  站点名称，默认 anyrouter，可选 agentrouter 或自定义
#   name         可选  账号别名，仅用于日志/通知显示
#   _username    可选  当 cookie 失效时浏览器自动登录用的账户名
#   _password    可选  与 _username 配对使用的密码

# 方式 A：仅用 cookie（最常见，cookie 失效后需手动更新）
ANYROUTER_ACCOUNTS="[{\"cookies\":{\"session\":\"你的session值\"},\"api_user\":\"你的api_user值\",\"name\":\"账号A\"}]"

# 方式 B：cookie + 账密兜底（推荐，cookie 失效时浏览器自动重新登录）
# ANYROUTER_ACCOUNTS="[{\"cookies\":{\"session\":\"你的session值\"},\"api_user\":\"148714\",\"name\":\"账号A\",\"_username\":\"NianLiu.jj\",\"_password\":\"你的登录密码\"}]"

# 方式 C：仅账密（首次运行就直接由浏览器登录获取 cookie）
# ANYROUTER_ACCOUNTS="[{\"cookies\":{},\"api_user\":\"148714\",\"name\":\"账号A\",\"_username\":\"NianLiu.jj\",\"_password\":\"你的登录密码\"}]"

# 方式 D：多账号示例
# ANYROUTER_ACCOUNTS="[{\"cookies\":{\"session\":\"aaa\"},\"api_user\":\"111\",\"name\":\"账号A\"},{\"cookies\":{\"session\":\"bbb\"},\"api_user\":\"222\",\"provider\":\"agentrouter\",\"name\":\"账号B\"}]"

# -------- 账密的另一种写法：按账号序号注入（避免写在 JSON 里）--------
# 序号 _<n> 与 ANYROUTER_ACCOUNTS 中账号的下标一一对应（从 1 开始）
# 当账号 JSON 里没有 _username/_password 时，程序会回退读取这里
# ANYROUTER_USERNAME_1=NianLiu.jj
# ANYROUTER_PASSWORD_1=你的登录密码
# ANYROUTER_USERNAME_2=另一个账号
# ANYROUTER_PASSWORD_2=另一个密码

# -------- 自定义 Provider（可选）--------
# JSON 对象格式，键为 provider 名称，会覆盖内置同名 provider
# PROVIDERS={"custom":{"domain":"https://example.com","api_user_key":"x-api-user","sign_in_path":"/api/user/sign_in"}}

# -------- Playwright 运行时（可选）--------
# 调试时显示真实浏览器窗口
# PLAYWRIGHT_HEADLESS=false
# 指定 Python 解释器路径（默认 python3，建议在 venv 时显式指定）
# PYTHON_BIN=.venv/bin/python3
# 自定义 Playwright 脚本路径（默认 scripts/playwright_checkin.py，相对项目根目录）
# PLAYWRIGHT_SCRIPT=scripts/playwright_checkin.py

# -------- 邮件通知（可选）--------
# 仅在签到失败或余额变动时发送
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# CUSTOM_SMTP_SERVER=
